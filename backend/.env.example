PORT=5000
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=*******888
DB_NAME=biztrack_db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:*******888@localhost:5432/biztrack_db
JWT_SECRET=***************
JWT_REFRESH_SECRET=***************

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=***************
EMAIL_PASS=***************
EMAIL_FROM=***************
# CLIENT_URL=http://192.168.1.12:5173
CLIENT_URL=http://localhost:5173
# CLIENT_URL=https://aafa-154-72-94-6.ngrok-free.app
CLIENT_LOGO_URL="BizTrack"

# Cloudinary backend SDK credentials (required for image deletion)
CLOUDINARY_CLOUD_NAME=xxxxxxxxx
CLOUDINARY_API_KEY=***************
CLOUDINARY_API_SECRET=***************

CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_API_KEY=***************
CLICKPESA_API_CLIENT_ID=***************
SUBSCRIPTION_GRACE_DAYS=3
# AI Business Summary
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_SUMMARY_CACHE_MINUTES=20

# -------------------------------------------------------
# AI Provider Configuration
# Supported: gemini, groq, openai, ollama
# Change provider without changing application code.
# -------------------------------------------------------
AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=30000
AI_TEMPERATURE=0.65
AI_SUMMARY_CACHE_MINUTES=20

# Gemini (Google AI Studio API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local server (no key required for local use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

AI_CONVERSATION_TTL_MINUTES=60

# AI native function calling guardrails
AI_NATIVE_FUNCTION_CALLING=true
AI_MAX_TOOL_CALLS=4
AI_MAX_TOOL_ROUNDS=2
AI_TOOL_TIMEOUT_MS=10000
AI_TOOL_TEMPERATURE=0.2

# -------------------------------------------------------
# Scheduled Notifications
# Runs low-stock, payment-due and daily-summary checks.
# -------------------------------------------------------
BUSINESS_TIMEZONE=Africa/Dar_es_Salaam
NOTIFICATION_SCHEDULER_HOUR=8
NOTIFICATION_SCHEDULER_ENABLED=true

STOCK_SNAPSHOT_TIME=23:55

# -------------------------------------------------------
# Performance (all optional)
# -------------------------------------------------------
# Log every request as: [PERF] GET /api/x 200 total=140ms db=5q/60ms auth=3ms
# Without PERF_LOG only requests slower than PERF_SLOW_REQUEST_MS are logged.
# PERF_LOG=1
# PERF_SLOW_REQUEST_MS=1000
# Seconds-level caches for role/permission and subscription checks (milliseconds).
# 0 switches a cache off.
# ACCESS_CACHE_TTL_MS=30000
# SUBSCRIPTION_CACHE_TTL_MS=30000

# -------------------------------------------------------
# Developer account (only this email can see/use the Integrations page)
# Several emails can be comma-separated. Leave empty = nobody has access.
# -------------------------------------------------------
DEVELOPER_EMAIL=

# -------------------------------------------------------
# Support inbox(es). SMS top-up requests (for providers that can't be paid
# through an API) are emailed here. Several addresses: comma-separated.
# Falls back to SUPPORT_ADMIN_EMAILS, then DEVELOPER_EMAIL.
# -------------------------------------------------------
SUPPORT_EMAIL=

# Phone that receives an SMS when a support ticket is opened.
# The phone saved on the user whose email is DEVELOPER_EMAIL is used as well.
# Several numbers: comma-separated, with the country code and no plus sign.
# DEVELOPER_PHONE=2557XXXXXXXX

# -------------------------------------------------------
# Database upgrades and backups (new in BizTrack 2)
# The database structure changes ONLY with `npm run db:migrate`, which first makes a full backup and tests restoring it.
# -------------------------------------------------------
# BACKUP_DIR=./backups                 where those safety backups are written
# SKIP_BACKUP=1                        skip the safety backup (only if you already have your own)
# REQUIRE_MIGRATIONS=1                 refuse to start the server while migrations are pending
# CLIENT_URL may list several origins separated by commas (web app, installed app, preview)
# DB_SSL=true                          connect to PostgreSQL over SSL
# SQL_LOG=1                            print every SQL statement (debugging only)
# Silent printing (QZ Tray). Paste the private key here. Keep the quotes and write each line break as \n.
# QZ_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Or point at a PEM file instead of pasting the key:
# QZ_PRIVATE_KEY_PATH=./certs/qz-private-key.pem

# -------------------------------------------------------
# Security: rate limits on sign-in and account recovery (new in this release)
# -------------------------------------------------------
# TRUST_PROXY=1                        set when the server is behind a proxy (cPanel/Passenger, nginx) so limits use the visitor's real address
# LOGIN_RATE_MAX=10                    wrong sign-in tries allowed per address + e-mail ...
# LOGIN_RATE_WINDOW_MIN=15             ... in this many minutes (correct sign-ins are never counted)
# LOGIN_IP_RATE_MAX=100                wrong tries allowed from one address across ALL e-mails in the same window
# REGISTER_RATE_MAX=20                 new accounts per address per hour
# EMAIL_ACTION_RATE_MAX=10             verification / reset e-mails per address + e-mail per hour
# TOKEN_RATE_MAX=30                    failed e-mail-link tokens per address per 15 minutes
# VERIFY_PASSWORD_RATE_MAX=10          wrong "confirm password" tries per person per 15 minutes
# RATE_LIMIT_DISABLED=1                switch every limiter off (automated tests only — never in production)
